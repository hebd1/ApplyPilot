# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider (this checkout prefers Cursor Auto)
CURSOR_API_KEY=           # Cursor Auto + Stage 6 apply (cursor.com/dashboard/integrations)
LLM_MODEL=auto
# OPENROUTER_API_KEY=     # OpenRouter fallback (use LLM_MODEL=openrouter/free)
# GEMINI_API_KEY=         # Gemini (alternative)
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name

# Auto-Apply (optional)
APPLY_BACKEND=cursor      # Cursor SDK + Playwright + Gmail MCP
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply
# CHROME_PATH=            # Optional Chromium path for CDP

# Gmail MCP (OTP read-only by default — tokens in ~/.gmail-mcp/)
# NEVER update/delete mail, change Gmail settings, or send without explicit consent.
# APPLY_ALLOW_GMAIL_SEND=1   # Opt-in outbound send ONLY; mutate/settings stay forbidden

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
